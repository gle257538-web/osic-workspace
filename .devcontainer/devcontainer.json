{
  "name": "IIC-OSIC-TOOLS",
  "image": "ghcr.io/iic-jku/iic-osic-tools-devcontainer:latest",
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "noVNC Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "root"
}
